rules_version = '2';

// Security rules for Ultimativni Križić-Kružić
// Adjust the collection names if yours differ. The defaults below assume:
//   - players/{uid}      : Elo/profile data, owned by the user
//   - games/{gameId}     : online matches, readable by both players, writable by participants
//   - leaderboard/{uid}  : public read, write only by the owner
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: must be signed in
    function signedIn() {
      return request.auth != null;
    }

    // Players: users can read any player profile, but only modify their own.
    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Online games: only players in the match can read/write.
    match /games/{gameId} {
      allow read: if signedIn() && (
        resource == null ||
        request.auth.uid in resource.data.players
      );
      allow create: if signedIn() && request.auth.uid in request.resource.data.players;
      allow update: if signedIn() && request.auth.uid in resource.data.players;
      allow delete: if signedIn() && request.auth.uid in resource.data.players;
    }

    // Leaderboard: world-readable, owner-writable.
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
