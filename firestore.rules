rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isPlayer1(data) {
      return data.player1uid == request.auth.uid;
    }

    function isPlayer2(data) {
      return data.get('player2uid', null) == request.auth.uid;
    }

    function joiningAsPlayer2(oldData, newData) {
      // Slot is open if player2uid was missing or null on the old doc,
      // and the new doc writes the joiner's UID into it.
      return oldData.get('player2uid', null) == null
          && newData.player2uid == request.auth.uid;
    }

    match /players/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /games/{gameId} {
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.player1uid == request.auth.uid;

      allow update: if signedIn() && (
        isPlayer1(resource.data) ||
        isPlayer2(resource.data) ||
        joiningAsPlayer2(resource.data, request.resource.data)
      );

      allow delete: if signedIn() && (
        isPlayer1(resource.data) || isPlayer2(resource.data)
      );
    }

    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}